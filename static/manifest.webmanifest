{
  "id": "/",
  "name": "Muzart",
  "short_name": "Muzart",
  "description": "Muzart — fraktalne studio zegarów muzycznych i aranżer Chronos. Nagrywaj, tnij, układaj i zapętlaj dźwięki.",
  "lang": "pl",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#121212",
  "theme_color": "#1B2631",
  "categories": ["music", "entertainment", "education"],
  "icons": [
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Studio", "url": "/?tab=studio", "icons": [{ "src": "/static/icons/icon-96.png", "sizes": "96x96" }] },
    { "name": "Aranżer Chronos", "url": "/?tab=chronos", "icons": [{ "src": "/static/icons/icon-96.png", "sizes": "96x96" }] }
  ],
  "file_handlers": [
    { "action": "/?tab=chronos", "accept": { "application/x-muzart-project": [".mzt"] } }
  ]
}
